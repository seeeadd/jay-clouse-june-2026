{
  "redirects": [
    {
      "source": "/lab-audit",
      "destination": "/toolkit/lab-audit.html",
      "statusCode": 301
    },
    {
      "source": "/diagnostic",
      "destination": "/toolkit/mechanics-diagnostic.html",
      "statusCode": 301
    },
    {
      "source": "/offer",
      "destination": "/self-paced/",
      "statusCode": 307
    },
    {
      "source": "/offer/",
      "destination": "/self-paced/",
      "statusCode": 307
    },
    {
      "source": "/offer-short",
      "destination": "/self-paced/",
      "statusCode": 307
    },
    {
      "source": "/offer-short/",
      "destination": "/self-paced/",
      "statusCode": 307
    }
  ],
  "headers": [
    {
      "source": "/toolkit/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/offer-review/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/offer-short-review/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)/assets/transcripts/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
